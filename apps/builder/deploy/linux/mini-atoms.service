[Unit]
Description=Mini Atoms trusted host controller (restricted review only)
Requires=docker.service
After=docker.service network-online.target
Wants=network-online.target
StartLimitIntervalSec=120
StartLimitBurst=3

[Service]
Type=simple
User=mini-atoms
Group=mini-atoms
SupplementaryGroups=docker
WorkingDirectory=/opt/mini-atoms/current/apps/builder
EnvironmentFile=/etc/mini-atoms/builder.env
Environment=M1_DATA_ROOT=/var/lib/mini-atoms
Environment=M1_PORT=8120
UMask=0077
ExecStartPre=/opt/node24/bin/node scripts/deploy-preflight.mjs /opt/mini-atoms/current /var/lib/mini-atoms --service-start
ExecStart=/opt/node24/bin/node src/server/main.ts
Restart=on-failure
RestartSec=10
KillSignal=SIGTERM
TimeoutStopSec=120
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/mini-atoms /opt/mini-atoms/current/spikes/m0-5-tsx-runtime/.local
MemoryHigh=512M
MemoryMax=768M
TasksMax=128
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
