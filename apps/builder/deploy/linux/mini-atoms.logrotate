# Template only. Do not install alongside another rule matching these same logs.
/var/log/nginx/mini-atoms-access.log /var/log/nginx/mini-atoms-error.log {
    daily
    rotate 7
    maxsize 10M
    missingok
    notifempty
    compress
    delaycompress
    create 0640 www-data adm
    sharedscripts
    postrotate
        /bin/systemctl kill -s USR1 nginx.service >/dev/null 2>&1 || true
    endscript
}
