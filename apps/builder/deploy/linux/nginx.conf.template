# Template only. Render a single approved host/reviewer IPv4 before Stage 2.
# IP admission avoids HTTP Basic's Authorization header colliding with API Bearer.
map $request_method $mini_atoms_write_key { GET ""; default $binary_remote_addr; }
limit_req_zone $binary_remote_addr zone=mini_atoms_reads:10m rate=5r/s;
limit_req_zone $mini_atoms_write_key zone=mini_atoms_writes:10m rate=1r/s;
limit_conn_zone $binary_remote_addr zone=mini_atoms_connections:10m;
log_format mini_atoms_minimal '$time_iso8601 $request_method $uri $status $body_bytes_sent';
server {
    listen 443 ssl default_server;
    server_name __PUBLIC_HOST__;
    ssl_certificate /etc/mini-atoms/tls/fullchain.pem;
    ssl_certificate_key /etc/mini-atoms/tls/privkey.pem;
    ssl_protocols TLSv1.2 TLSv1.3;
    if ($http_host != "__PUBLIC_HOST__") { return 403; }
    if ($args != "") { return 400; }
    allow __REVIEWER_IPV4__;
    deny all;
    client_max_body_size 64k;
    client_header_timeout 5s;
    client_body_timeout 10s;
    keepalive_timeout 15s;
    limit_req_status 429;
    limit_conn_status 429;
    limit_req zone=mini_atoms_reads burst=40 nodelay;
    limit_req zone=mini_atoms_writes burst=3 nodelay;
    limit_conn mini_atoms_connections 16;
    access_log /var/log/nginx/mini-atoms-access.log mini_atoms_minimal;
    error_log /var/log/nginx/mini-atoms-error.log crit;
    add_header Strict-Transport-Security "max-age=86400" always;
    location / {
        proxy_pass http://127.0.0.1:8120;
        proxy_http_version 1.1;
        proxy_set_header Host "127.0.0.1:8120";
        proxy_set_header Origin $http_origin;
        proxy_set_header Authorization $http_authorization;
        proxy_set_header Cookie "";
        proxy_set_header Sec-Fetch-Dest $http_sec_fetch_dest;
        proxy_set_header Sec-Fetch-Mode $http_sec_fetch_mode;
        proxy_set_header Sec-Fetch-Site $http_sec_fetch_site;
        proxy_set_header X-Forwarded-Host "";
        proxy_set_header X-Forwarded-Proto "";
        proxy_set_header X-Forwarded-For "";
        proxy_next_upstream off;
        proxy_redirect off;
        proxy_cache off;
        proxy_buffering off;
        proxy_read_timeout 15s;
        gzip off;
    }
}
