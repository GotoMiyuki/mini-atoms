# Copy to ignored .env.local. npm run setup creates a random access token.
M1_ACCESS_TOKEN=
M1_PORT=8120
M1_DAILY_JOBS=20
# Empty keeps the original localhost mode. Future approved HTTPS origin only, no trailing slash.
M1_PUBLIC_ORIGIN=
# Keep persistent data outside releases. Empty uses .local/data.
M1_DATA_ROOT=
# Compatible Chat Completions base URL; HTTPS required, e.g. https://api.deepseek.com
LLM_BASE_URL=
LLM_MODEL=
LLM_API_KEY=
